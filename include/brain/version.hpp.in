#ifndef BRAINVERSION_H
    #define BRAINVERSION_H // not VERSION_H: the guard of the libutils version header

    //----------------------------------------------------------------//
    /* INCLUDE */

    /* type */
    #include <string_view>   // std::string_view

    //----------------------------------------------------------------//
    /* DEFINE */

    // Definition of the library version (set by the cmake)
    #define __BRAIN_VERSION__ "@BRAIN_VERSION@"

namespace brain { // namespace start
//----------------------------------------------------------------//
/* GLOBAL */

inline constexpr std::string_view version = __BRAIN_VERSION__; // "vX.Y.Z"

} // namespace end
#endif /* BRAINVERSION_H */
